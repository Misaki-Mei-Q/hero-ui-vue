{
  "name": "@misaki-mei/heroui-vue-styles",
  "version": "0.1.0",
  "description": "Styles for HeroUI Vue components",
  "keywords": [
    "heroui",
    "vue",
    "vue3",
    "styles",
    "tailwindcss"
  ],
  "homepage": "https://misaki-mei-q.github.io/hero-ui-vue",
  "bugs": {
    "url": "https://github.com/Misaki-Mei-Q/hero-ui-vue/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Misaki-Mei-Q/hero-ui-vue.git",
    "directory": "packages/styles"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "style": "./src/styles.css"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./base/*": "./src/base/*",
    "./themes/*": "./src/themes/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@misaki-mei/heroui-vue-standard": "workspace:*",
    "@tailwindcss/vite": "^4.2.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "tailwindcss": ">=4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
