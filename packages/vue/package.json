{
  "name": "@misaki-mei/heroui-vue",
  "version": "0.1.0",
  "description": "Beautiful and modern Vue 3 UI library built with Tailwind CSS 4.0",
  "keywords": [
    "heroui",
    "vue",
    "vue3",
    "ui",
    "components",
    "tailwindcss"
  ],
  "homepage": "https://misaki-mei-q.github.io/hero-ui-vue",
  "bugs": {
    "url": "https://github.com/Misaki-Mei-Q/hero-ui-vue/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Misaki-Mei-Q/hero-ui-vue.git",
    "directory": "packages/vue"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@misaki-mei/heroui-vue-styles": "workspace:*",
    "@internationalized/date": "^3.12.1",
    "@vueuse/core": "^11.3.0",
    "radix-vue": "^1.9.11",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@misaki-mei/heroui-vue-standard": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^29.1.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.8.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  },
  "peerDependencies": {
    "tailwindcss": ">=4.0.0",
    "vue": ">=3.4.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
